{
  "name": "kaohsiung-travel-info",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "assets:sync": "node scripts/optimize-images.mjs && node scripts/optimize-fonts.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "verify": "npm run check && npm run build && npm run audit",
    "audit": "node --experimental-strip-types scripts/audit.ts",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
