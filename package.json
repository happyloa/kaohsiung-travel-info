{
  "name": "kaohsiung-travel-info",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build && npm audit",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aos": "^3.0.8",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "aos": "^2.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
